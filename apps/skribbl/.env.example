# WebSocket backend URL (Cloudflare Worker / realtime server).
# Set this in the yaply-skribbl Vercel project and redeploy after every change.
# https://.../room is accepted and converted to wss:// automatically.
NEXT_PUBLIC_REALTIME_URL=wss://yaply-realtime-production.yaplygames.workers.dev/room
# Or for local dev: ws://localhost:8787/room

# Main Yaply site URL used by the "Back to Yaply" link.
NEXT_PUBLIC_MAIN_URL=https://yaply-web.vercel.app
# Final production value: https://yaply.is-cool.dev

# Canonical origin of this Skribbl deployment, used for metadata and Open Graph
# images. The same variable is set on yaply-web, where it is the link to Skribbl.
NEXT_PUBLIC_SKRIBBL_URL=https://yaply-skribbl.vercel.app
# Local development: http://localhost:3001

# Verify a deployment with: curl https://<skribbl-site>/api/config
