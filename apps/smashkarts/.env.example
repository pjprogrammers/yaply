# Realtime backend shared with Skribbl and Chain Reaction.
# Set this in the yaply-smashkarts Vercel project and redeploy after every change.
# https://.../room is accepted and converted to wss:// automatically.
NEXT_PUBLIC_REALTIME_URL=wss://yaply-realtime-production.yaplygames.workers.dev/room
# Or for local dev: ws://localhost:8787/room

# Main Yaply site URL used by the "Back to Yaply" link.
NEXT_PUBLIC_MAIN_URL=https://yaply-web.vercel.app
# Final production value: https://yaply.is-cool.dev

# Canonical origin of this deployment, used for metadata and Open Graph images.
NEXT_PUBLIC_SITE_URL=https://yaply-smashkarts.vercel.app
# Local development: http://localhost:3003

# Verify a deployment with: curl https://<kart-riot-site>/api/config
