# Realtime backend shared with Skribbl and Chain Reaction.
# Set this in the yaply-smashkarts Vercel project and redeploy after every change.
# https://.../room is accepted and converted to wss:// automatically.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787/room

# Main Yaply site URL used by the "Back to Yaply" link.
NEXT_PUBLIC_MAIN_URL=http://localhost:3000

# Canonical origin of this Smash Karts deployment, used for metadata and Open
# Graph images. In Vercel set it to this project's public origin (the
# *.vercel.app deployment domain or a custom domain). The same variable is set
# on yaply-web, where it is the link to this game.
NEXT_PUBLIC_SMASHKARTS_URL=http://localhost:3003

# Verify a deployment with: curl https://<smash-karts-site>/api/config
