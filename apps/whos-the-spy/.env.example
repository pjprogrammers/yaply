# Who's the Spy deployment.
# NEXT_PUBLIC_* values are inlined at build time, so redeploy after changing them.
NEXT_PUBLIC_WHOS_THE_SPY_URL=http://localhost:3005
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_REALTIME_URL=http://localhost:8787
# Optional WebRTC ICE servers as a JSON array. Without this the client uses
# Google's public STUN server. Production rooms behind strict NATs need TURN:
# NEXT_PUBLIC_ICE_SERVERS=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]
