# WebSocket backend URL (Cloudflare Worker / realtime server).
# Set this in the yaply-chain Vercel project and redeploy after every change.
# https://.../room is accepted and converted to wss:// automatically.
NEXT_PUBLIC_REALTIME_URL=wss://yaply-realtime-production.yaplygames.workers.dev/room
# Or for local dev: ws://localhost:8787/room

# Main Yaply site URL used by the "Back to Yaply" link.
NEXT_PUBLIC_MAIN_URL=https://yaply-web.vercel.app
# Final production value: https://yaply.is-cool.dev

# Canonical origin of this Chain Reaction deployment, used for metadata and
# Open Graph images. The same variable is set on yaply-web, where it is the
# link to Chain Reaction.
NEXT_PUBLIC_CHAIN_URL=https://yaply-chain.vercel.app
# Local development: http://localhost:3002

# Verify a deployment with: curl https://<chain-site>/api/config
