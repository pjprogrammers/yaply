# Main Yaply site configuration.
# These values are inlined at build time. Set them in the yaply-web Vercel
# project and redeploy after every change.
#
# NEXT_PUBLIC_MAIN_URL is the canonical origin used by metadata, the sitemap
# and robots.txt. Keep it on the current deployment until the custom domain is
# live, then switch it to the final value below.
#
# Verify a deployment with: curl https://<main-site>/api/config
NEXT_PUBLIC_MAIN_URL=https://yaply-web.vercel.app
NEXT_PUBLIC_CHAIN_URL=https://yaply-chain.vercel.app
NEXT_PUBLIC_SKRIBBL_URL=https://yaply-skribbl.vercel.app
NEXT_PUBLIC_SMASHKARTS_URL=https://yaply-smashkarts.vercel.app

# Final production values (set these in Vercel once the custom domains are live):
# NEXT_PUBLIC_MAIN_URL=https://yaply.is-cool.dev
# NEXT_PUBLIC_CHAIN_URL=https://chain.yaply.is-cool.dev
# NEXT_PUBLIC_SKRIBBL_URL=https://skribbl.yaply.is-cool.dev
# NEXT_PUBLIC_SMASHKARTS_URL=https://kart-riot.yaply.is-cool.dev
