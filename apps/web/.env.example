# Main Yaply site configuration.
# These values are inlined at build time. Set them in the yaply-web Vercel
# project and redeploy after every change. No domain is hardcoded in the app.
#
# NEXT_PUBLIC_MAIN_URL is the canonical origin used by metadata, the sitemap
# and robots.txt. In Vercel set it to this project's public origin
# (the *.vercel.app deployment domain or a custom domain).
#
# Verify a deployment with: curl https://<main-site>/api/config
NEXT_PUBLIC_MAIN_URL=http://localhost:3000
NEXT_PUBLIC_CHAIN_URL=http://localhost:3002
NEXT_PUBLIC_SKRIBBL_URL=http://localhost:3001
NEXT_PUBLIC_SMASHKARTS_URL=http://localhost:3003
NEXT_PUBLIC_HOLEIO_URL=http://localhost:3004
NEXT_PUBLIC_WHOS_THE_SPY_URL=http://localhost:3005

# Optional search-console verification tokens. They are server-side build
# variables, not public runtime secrets. Add the same variables to the Vercel
# project and redeploy to emit the verification meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
