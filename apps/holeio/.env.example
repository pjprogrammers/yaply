# Realtime backend shared with the other online Yaply games.
# Set this in the yaply-holeio Vercel project and redeploy after every change.
# https://.../room is accepted and converted to wss:// automatically.
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8787/room

# Main Yaply site URL used by the "Back to Yaply" link.
NEXT_PUBLIC_MAIN_URL=http://localhost:3000

# Canonical origin of this Hole.io deployment, used for metadata and Open
# Graph images. In Vercel set it to this project's public origin (the
# *.vercel.app deployment domain or a custom domain). The same variable is set
# on yaply-web, where it is the link to this game.
NEXT_PUBLIC_HOLEIO_URL=http://localhost:3004

# Optional search-console verification tokens. They are server-side build
# variables, not public runtime secrets. Add the same variables to the Vercel
# project and redeploy to emit the verification meta tags.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Verify a deployment with: curl https://<holeio-site>/api/config
